# NOWPayments
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# SellAuth
SELLAUTH_API_KEY=your_sellauth_api_key
SELLAUTH_SHOP_ID=your_sellauth_shop_id

# Vercel deployment URL (no trailing slash)
BASE_URL=https://your-project.vercel.app

# Optional: where customers should be sent after NOWPayments success/cancel.
# Supports placeholders: {invoiceId} and {status}
# Example: https://your-store.com/checkout/{invoiceId}?status={status}
CUSTOMER_RETURN_URL_TEMPLATE=

# Neon Postgres (auto-injected by Vercel Marketplace, or set manually)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Admin secret for admin dashboard and protected admin API routes
ADMIN_SECRET=generate_a_random_string_here

# Optional rate limits (per IP). Set LIMIT or WINDOW_MS to 0 to disable a limiter.
RATE_LIMIT_PAY_LIMIT=120
RATE_LIMIT_PAY_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_STATUS_LIMIT=300
RATE_LIMIT_PAYMENT_STATUS_WINDOW_MS=60000
RATE_LIMIT_IPN_LIMIT=1200
RATE_LIMIT_IPN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_AUTH_LIMIT=20
RATE_LIMIT_ADMIN_AUTH_WINDOW_MS=60000
RATE_LIMIT_ADMIN_API_LIMIT=240
RATE_LIMIT_ADMIN_API_WINDOW_MS=60000
